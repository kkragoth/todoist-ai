    "@tanstack/react-router": "^1.170.35",
    "cn": "^0.3.0",
    "fuse.js": "^7.5.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.37",
