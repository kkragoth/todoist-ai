set dotenv-load

default:
    @just --list

# Run the ReAct CLI against Ollama (default backend in main.py).
# Usage: just cli-ollama [model]  (default: local-qwen, override via OLLAMA_MODEL env)
cli-ollama model="local-qwen":
    OLLAMA_MODEL="{{model}}" LLM_BACKEND="ollama" uv run python main.py

# Run the ReAct CLI against a llama.cpp OpenAI-compatible server.
# Usage: just cli-llamacpp [model] [url]
cli-llamacpp model="local-model" url="http://localhost:8080/v1":
    LLM_BACKEND="llamacpp" LLAMACPP_MODEL="{{model}}" LLAMACPP_URL="{{url}}" uv run python main.py
