# Postgres (docker service name) by default; localhost when running the
# API outside compose (e.g. `just dev-local` for a bare-metal run).
POSTGRES_DB=todoist_ai
POSTGRES_USER=todoist_ai
POSTGRES_PASSWORD=change_me_db_password

# Inside compose the host is `postgres`; outside compose use localhost.
# Docker services override this via compose `environment` anyway.
DATABASE_URL=postgresql://todoist_ai:change_me_db_password@localhost:5432/todoist_ai
REDIS_URL=redis://localhost:6379/0

# App
PORT=8000
SECRET_KEY=change_me_super_secret_min_16_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Postgres pool (used when DATABASE_URL is not sqlite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
