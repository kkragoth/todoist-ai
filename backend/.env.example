# Postgres (docker service name) by default; localhost when running the
# API outside compose (e.g. `just dev-local` for a bare-metal run).
POSTGRES_DB=todoist_ai
POSTGRES_USER=todoist_ai
POSTGRES_PASSWORD=change_me_db_password

# Inside compose the host is `postgres`; outside compose use localhost.
# Docker services override this via compose `environment` anyway.
DATABASE_URL=postgresql://todoist_ai:change_me_db_password@localhost:5432/todoist_ai
REDIS_URL=redis://localhost:6379/0

# App
PORT=8000
SECRET_KEY=change_me_super_secret_min_16_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Postgres pool (used when DATABASE_URL is not sqlite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5

# Chat agent (swappable providers: ollama | llamacpp | openrouter)
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:31b-cloud
# Bare-metal runs reach Ollama on localhost. Inside `just dev` (docker),
# point this at the host instead: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
LLAMACPP_URL=http://localhost:8080/v1
LLAMACPP_MODEL=local-model
# LLAMACPP_API_KEY=sk-no-key
# OPENROUTER_API_KEY= (also requires OPENROUTER_ENABLED=true below)
# Feature flag for paid inference. Fail-closed: any openrouter request
# (per-request or LLM_PROVIDER default) is rejected unless true.
OPENROUTER_ENABLED=false
OPENROUTER_MODEL=google/gemma-3-27b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=todoist-ai

# Chat loop guards
CHAT_RECURSION_LIMIT=25
CHAT_HISTORY_LIMIT=30
CHAT_TURN_TIMEOUT_SECONDS=180
